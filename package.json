{
  "name": "nuhieh-student",
  "author": "Khalid Elnaghi",
  "version": "1.0.0",
  "description": "Nuhieh Student dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "npm run rm:all && npm install && npm run dev",
    "re:build": "npm run rm:all && npm install && npm run build",
    "dev:ts": "npm run dev & npm run ts:watch",
    "ts": "tsc --noEmit --incremental",
    "ts:watch": "npm run ts -- --watch"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "glob": "^10.5.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@iconify/react": "^4.1.1",
    "@mui/lab": "5.0.0-alpha.176",
    "@mui/material": "^5.17.1",
    "@mui/x-data-grid": "^6.20.4",
    "@mui/x-date-pickers": "^6.20.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "apexcharts": "^4.7.0",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.20.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.18.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "mui-one-time-password-input": "^2.0.3",
    "next": "^14.2.35",
    "notistack": "^3.0.2",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^13.5.0",
    "simplebar-react": "^3.3.1",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "use-debounce": "^10.0.5",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.35",
    "@svgr/webpack": "^8.1.0",
